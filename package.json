{
    "name": "SaSLoop",
    "version": "1.0.0",
    "description": "SaSLoop ERP | AI Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "tunnel": "node start-tunnel.js",
        "dev": "concurrently \"nodemon server.js\" \"node start-tunnel.js\"",
        "build": "npm run build-frontend",
        "build-frontend": "cd SaSLoop-dashboard && npm install --legacy-peer-deps && set \"NODE_OPTIONS=--max-old-space-size=4096\" && npm run build && cd .. && if exist dist rd /s /q dist && xcopy /e /i SaSLoop-dashboard\\build dist",
        "update-live": "git pull origin main && npm install && npm run build-frontend && pm2 restart SaSLoop-Backend && pm2 save",
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev:local": "nodemon server.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@ngrok/ngrok": "^1.7.0",
        "axios": "^1.14.0",
        "bcrypt": "^6.0.0",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-fileupload": "^1.5.2",
        "express-rate-limit": "^8.4.1",
        "form-data": "^4.0.5",
        "googleapis": "^171.4.0",
        "groq-sdk": "^1.1.2",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.3",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.0.1",
        "pg": "^8.20.0",
        "puppeteer": "^24.40.0",
        "qrcode": "^1.5.4",
        "react-router-dom": "^7.14.0",
        "whatsapp-web.js": "^1.34.6",
        "xlsx": "^0.18.5",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.27",
        "nodemon": "^3.1.9",
        "postcss": "^8.5.9",
        "tailwindcss": "^4.2.2"
    }
}
