{
    "name":  "SaSLoop",
    "version":  "1.0.0",
    "description":  "SaSLoop ERP | AI Backend",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "tunnel":  "node start-tunnel.js",
                    "dev":  "concurrently \"nodemon server.js\" \"node start-tunnel.js\"",
                    "build":  "npm run build-frontend",
                    "build-frontend":  "cd SaSLoop-dashboard \u0026\u0026 npm install --legacy-peer-deps \u0026\u0026 set \"NODE_OPTIONS=--max-old-space-size=4096\" \u0026\u0026 npm run build \u0026\u0026 cd .. \u0026\u0026 if exist dist rd /s /q dist \u0026\u0026 xcopy /e /i SaSLoop-dashboard\\build dist",
                    "update-live":  "git pull origin main \u0026\u0026 npm install \u0026\u0026 npm run build-frontend \u0026\u0026 pm2 restart SaSLoop-Backend \u0026\u0026 pm2 save",
                    "test":  "echo \"Error: no test specified\" \u0026\u0026 exit 1",
                    "dev:local":  "nodemon server.js"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
