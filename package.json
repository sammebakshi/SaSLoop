                         "helmet":  "^8.1.0",
                         "hpp":  "^0.2.3",
                         "jsonwebtoken":  "^9.0.3",
                         "node-cron":  "^4.2.1",
                         "pg":  "^8.20.0",
                         "puppeteer":  "^24.40.0",
                         "qrcode":  "^1.5.4",
                         "react-router-dom":  "^7.14.0",
                         "whatsapp-web.js":  "^1.34.6",
                         "xlsx":  "^0.18.5",
                         "xss-clean":  "^0.1.4"
                     },
