{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.wwebjs_auth/**": true,
    "**/.wwebjs_cache/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/backups/**": true,
    "**/uploads/**": true,
    "**/*.exe": true,
    "**/*.tar.gz": true,
    "**/*.apk": true,
    "**/*.log": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.wwebjs_auth": true,
    "**/.wwebjs_cache": true,
    "**/build": true,
    "**/dist": true,
    "**/backups": true,
    "**/*.exe": true,
    "**/*.tar.gz": true,
    "**/*.apk": true,
    "**/*.log": true
  },
  "files.exclude": {
    "**/*.exe": true,
    "**/*.tar.gz": true,
    "**/*.apk": true,
    "**/hs_err_pid*.log": true,
    "**/replay_pid*.log": true
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "javascript.suggest.autoImports": false
}
