import React, { useState, useEffect } from 'react';
import { 
  ShoppingCart, History, Settings, User, Search, Plus, Trash2, 
  LogOut, Utensils, Zap, Sun, Moon, Home, TrendingUp, Calendar, 
  RefreshCcw, Package, Truck, ShoppingBag, Zap as QuickIcon,
  Printer, Save, CheckCircle, Globe, QrCode, List, Bell, Monitor,
  BarChart3, Store, PieChart, Activity, WifiOff, CreditCard, FileText,
  Filter, Download, ChevronRight, Eye, ChevronDown, Clock, ArrowRight
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { posService, authService, API_BASE } from './services/api';
import { ToastContainer, toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';

// --- THEME CONSTANTS ---
const THEME = {
  dark: {
    bg: 'bg-[#0f172a]',
    sidebar: 'bg-[#1e293b]',
    card: 'bg-white/5 border-white/10 backdrop-blur-md',
    header: 'bg-[#0f172a]/80 backdrop-blur-md border-white/5',
    textPrimary: 'text-white',
    textSecondary: 'text-slate-400'
  },
  light: {
    bg: 'bg-[#f8fafc]',
    sidebar: 'bg-white',
    card: 'bg-white border-slate-200 shadow-sm',
    header: 'bg-white/80 backdrop-blur-md border-slate-200',
    textPrimary: 'text-slate-900',
    textSecondary: 'text-slate-500'
  }
};

// --- HELPER COMPONENTS ---

const SidebarIcon = ({ icon, active, onClick, label }) => (
  <button onClick={onClick} className={`w-14 h-12 flex flex-col items-center justify-center transition-all relative group ${active ? 'text-emerald-400' : 'text-slate-500 hover:text-white'}`}>
    {active && <motion.div layoutId="sidebar-active" className="absolute right-0 w-1 h-6 bg-emerald-500 rounded-l-full shadow-[0_0_10px_rgba(16,185,129,0.5)]" />}
    <div className={`transition-transform duration-300 ${active ? 'scale-110' : 'group-hover:scale-110'}`}>{icon}</div>
    <span className={`text-[6px] font-black uppercase tracking-widest mt-1 ${active ? 'text-emerald-400' : 'text-slate-500'}`}>{label}</span>
  </button>
);

const DashboardStat = ({ title, value, subValue, icon, accentColor = "text-emerald-400", isDark }) => {
  const t = isDark ? THEME.dark : THEME.light;
  return (
    <div className={`p-3 rounded-xl border transition-all ${t.card}`}>
      <div className="flex items-center gap-2 mb-1.5"><div className={`p-1.5 rounded-lg bg-emerald-500/10 ${accentColor}`}>{icon}</div><span className={`text-[8px] font-black uppercase tracking-widest ${t.textSecondary}`}>{title}</span></div>
      <div className="flex items-baseline gap-1.5"><span className={`text-sm font-black italic tracking-tight ${t.textPrimary}`}>{value}</span><span className={`text-[8px] font-bold ${t.textSecondary}`}>({subValue})</span></div>
    </div>
  );
};

const ProductCard = ({ item, currency, isDark, onAdd }) => {
  const t = isDark ? THEME.dark : THEME.light;
  const isVeg = item.is_veg === 1 || item.veg_non_veg?.toLowerCase() === 'veg' || item.product_name?.toLowerCase().includes('veg');
  let fullImageUrl = item.image_url;
  if (fullImageUrl && !fullImageUrl.startsWith('http')) {
      fullImageUrl = `${API_BASE}${fullImageUrl.startsWith('/') ? '' : '/'}${fullImageUrl}`;
  }
  const textStrokeStyle = { textShadow: '1px 1px 2px rgba(0,0,0,0.8)' };
  const isOutOfStock = item.stock !== undefined && item.stock <= 0;
  
  return (
    <div onClick={() => !isOutOfStock && onAdd()} className={`relative group rounded-xl cursor-pointer transition-all flex flex-col h-44 overflow-hidden ${t.card} border-0 ${isOutOfStock ? 'opacity-50 grayscale cursor-not-allowed' : ''}`}>
      <div className="absolute top-2 right-2 z-10 p-0.5 bg-white/90 rounded-sm scale-75 origin-top-right"><div className={`w-2.5 h-2.5 rounded-full border-2 ${isVeg ? 'border-emerald-600' : 'border-rose-600'} flex items-center justify-center`}><div className={`w-1 h-1 rounded-full ${isVeg ? 'bg-emerald-600' : 'bg-rose-600'}`} /></div></div>
      {item.stock !== undefined && (
         <div className={`absolute top-2 left-2 z-10 px-1.5 py-0.5 rounded text-[6px] font-black uppercase ${item.stock < 5 ? 'bg-rose-500 text-white animate-pulse' : 'bg-black/50 text-white'}`}>
            {isOutOfStock ? 'Out of Stock' : `${item.stock} Left`}
         </div>
      )}
      <div className="flex-1 overflow-hidden shrink-0 bg-slate-800">{fullImageUrl ? <img src={fullImageUrl} className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" /> : <div className="w-full h-full flex items-center justify-center opacity-10"><Package size={30} /></div>}</div>
      <div className="p-2.5 bg-gradient-to-t from-black/90 via-black/40 to-transparent absolute bottom-0 left-0 right-0"><h4 className="text-[9px] font-black uppercase italic text-white mb-0.5 tracking-tight truncate" style={textStrokeStyle}>{item.product_name}</h4><p className="text-[11px] font-black text-emerald-300" style={textStrokeStyle}>{currency}{parseFloat(item.price || 0).toFixed(2)}</p></div>
    </div>
  );
};

const CartItem = ({ item, currency, isDark, onUpdate, onRemove, onModifierUpdate }) => {
  const t = isDark ? THEME.dark : THEME.light;
  const [showNote, setShowNote] = useState(false);
  
  return (
    <div className={`flex flex-col gap-1 p-2 rounded-xl border ${t.card}`}>
       <div className="flex items-center gap-2">
          <div className="flex-1 min-w-0" onClick={() => setShowNote(!showNote)}>
             <h4 className={`text-[9px] font-black uppercase italic truncate ${t.textPrimary}`}>{item.product_name}</h4>
             <div className="flex items-center gap-2 mt-0.5">
                <span className="text-[9px] font-black text-emerald-400">{currency}{parseFloat(item.price).toFixed(0)}</span>
                {item.modifier && <span className="text-[7px] font-bold text-amber-500 uppercase flex items-center gap-1"><FileText size={8}/> {item.modifier}</span>}
             </div>
          </div>
          <div className="flex items-center bg-white/5 rounded-lg p-0.5 shrink-0">
             <button onClick={(e) => { e.stopPropagation(); onUpdate(item.quantity - 1); }} className="w-5 h-5 flex items-center justify-center text-xs text-slate-400 hover:text-white">-</button>
             <span className="w-6 text-center text-[9px] font-black">{item.quantity}</span>
             <button onClick={(e) => { e.stopPropagation(); onUpdate(item.quantity + 1); }} className="w-5 h-5 flex items-center justify-center text-xs text-slate-400 hover:text-white">+</button>
          </div>
          <div className="text-right shrink-0 min-w-[50px]">
             <p className={`text-[9px] font-black ${t.textPrimary}`}>{currency}{(item.price * item.quantity).toFixed(0)}</p>
             <button onClick={(e) => { e.stopPropagation(); onRemove(); }} className="text-slate-500 hover:text-rose-500 transition-colors"><Trash2 size={12}/></button>
          </div>
       </div>
       {showNote && (
          <motion.div initial={{ height: 0, opacity: 0 }} animate={{ height: 'auto', opacity: 1 }} className="mt-1">
             <input 
                type="text" 
                placeholder="Add special instructions..." 
                autoFocus
                value={item.modifier || ''}
                onChange={(e) => onModifierUpdate(e.target.value)}
                onBlur={() => setShowNote(false)}
                className={`w-full px-2 py-1.5 rounded-lg border text-[8px] font-bold outline-none ${isDark ? 'bg-black/20 border-white/10 text-white' : 'bg-slate-50 border-slate-200 text-slate-900'}`} 
             />
          </motion.div>
       )}
    </div>
  );
};

const KOTHistoryView = ({ tableKots, isDark }) => (
   <div className="space-y-2 mt-4 max-h-[300px] overflow-y-auto no-scrollbar">
      <h3 className="text-[8px] font-black uppercase tracking-[0.2em] text-slate-500 mb-3 flex items-center gap-2"><History size={12}/> Table Order History</h3>
      {tableKots?.map((kot, idx) => (
         <div key={idx} className={`p-3 rounded-xl border ${isDark ? 'bg-white/5 border-white/5' : 'bg-white border-slate-100 shadow-sm'}`}>
            <div className="flex justify-between items-center mb-2">
               <span className="text-[9px] font-black text-emerald-400">{kot.id}</span>
               <span className={`px-2 py-0.5 rounded-md text-[7px] font-black uppercase ${kot.status === 'SERVED' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-amber-500/10 text-amber-500 animate-pulse'}`}>{kot.status}</span>
            </div>
            <div className="space-y-1">
               {kot.items.map((it, i) => (
                  <div key={i} className="flex justify-between text-[8px] font-bold text-slate-400">
                     <span>{it.product_name} x{it.quantity}</span>
                     {it.modifier && <span className="text-[7px] text-amber-500 italic">({it.modifier})</span>}
                  </div>
               ))}
            </div>
            <div className="mt-2 pt-2 border-t border-dashed border-white/5 text-[7px] font-bold text-slate-600 uppercase flex justify-between">
               <span>{new Date(kot.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
               <span>{kot.items.length} Items</span>
            </div>
         </div>
      ))}
      {!tableKots?.length && <div className="p-10 text-center opacity-20 text-[9px] font-black uppercase italic">No active KOTs for this table</div>}
   </div>
);

const UniversalPOS = () => {
  const [theme, setTheme] = useState(localStorage.getItem('pos_theme') || 'dark');
  const isDark = theme === 'dark';
  const t = isDark ? THEME.dark : THEME.light;
  const toggleTheme = () => setTheme(prev => prev === 'dark' ? 'light' : 'dark');
  useEffect(() => { localStorage.setItem('pos_theme', theme); }, [theme]);

  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [activeTab, setActiveTab] = useState('home');
  const [billingView, setBillingView] = useState('tables');
  const [orderType, setOrderType] = useState('DINE_IN');
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [isLoggingIn, setIsLoggingIn] = useState(false);

  const [customerName, setCustomerName] = useState('');
  const [customerPhone, setCustomerPhone] = useState('');
  const [paymentMethod, setPaymentMethod] = useState('CASH');
  const [discount, setDiscount] = useState({ type: 'NONE', value: 0 });
  const [isKOTPending, setIsKOTPending] = useState(false);
  const [lastKOTId, setLastKOTId] = useState(null);
  const [customerDb, setCustomerDb] = useState(() => {
    const saved = localStorage.getItem('pos_customer_db');
    return saved ? JSON.parse(saved) : {};
  });
  
  useEffect(() => {
    localStorage.setItem('pos_customer_db', JSON.stringify(customerDb));
  }, [customerDb]);

  const [catalog, setCatalog] = useState([]);
  const [categories, setCategories] = useState([]);
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [tables, setTables] = useState([]);
  const [cart, setCart] = useState([]);
  
  const [tableCarts, setTableCarts] = useState({});
  const [tableStatuses, setTableStatuses] = useState({});

  const [expenses, setExpenses] = useState(() => {
    const saved = localStorage.getItem('pos_expenses');
    return saved ? JSON.parse(saved) : [];
  });
  
  useEffect(() => {
    localStorage.setItem('pos_expenses', JSON.stringify(expenses));
  }, [expenses]);

  const [recentOrders, setRecentOrders] = useState(() => {
    const saved = localStorage.getItem('pos_local_orders');
    return saved ? JSON.parse(saved) : [];
  });
  
  useEffect(() => {
    localStorage.setItem('pos_local_orders', JSON.stringify(recentOrders));
    calculateStats(recentOrders);
  }, [recentOrders]);

  const [selectedReceipt, setSelectedReceipt] = useState(null);
  const [dateFrom, setDateFrom] = useState(new Date().toISOString().split('T')[0]);
  const [dateTo, setDateTo] = useState(new Date().toISOString().split('T')[0]);
  const [receiptFilterType, setReceiptFilterType] = useState('All Types');

  const [stats, setStats] = useState({
    todaySales: 0, todayCount: 0, totalSales: 0, totalCount: 0, monthSales: 0, monthCount: 0,
    offlineSales: 0, onlineSales: 0, dineInSales: 0, quickSales: 0, takeawaySales: 0, deliverySales: 0,
    totalTax: 0, totalDiscount: 0
  });

  const [config, setConfig] = useState({ currency: 'Rs', tax_rate: 0, business_type: 'RESTAURANT' });
  const [business, setBusiness] = useState(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedTable, setSelectedTable] = useState(null);
  const [activeFloor, setActiveFloor] = useState('Ground Floor');
  const [floors, setFloors] = useState(['Ground Floor', 'First Floor', 'Rooftop']);
  const [kotHistory, setKotHistory] = useState(() => {
    const saved = localStorage.getItem('pos_kot_history');
    return saved ? JSON.parse(saved) : {};
  });

  useEffect(() => {
    localStorage.setItem('pos_kot_history', JSON.stringify(kotHistory));
  }, [kotHistory]);

  const [isAiAnalyzing, setIsAiAnalyzing] = useState(false);
  const [aiAdvice, setAiAdvice] = useState(null);
  const [availablePrinters, setAvailablePrinters] = useState([
    { name: 'Everycom-80-Series', id: 'usb_01' },
    { name: 'AnyDesk Printer', id: 'sys_01' },
    { name: 'Microsoft Print to PDF', id: 'sys_02' },
    { name: 'Microsoft XPS Document Writer', id: 'sys_03' },
    { name: 'Fax', id: 'sys_04' },
    { name: 'Send To OneNote 2010', id: 'sys_05' }
  ]);

  const [posSettings, setPosSettings] = useState(() => {
    const saved = localStorage.getItem('pos_terminal_settings');
    return saved ? JSON.parse(saved) : {
      businessName: '',
      address: '',
      phone: '',
      gstin: '',
      printerType: 'THERMAL_80MM',
      printerConnection: 'USB',
      printerIp: '',
      printerName: 'Default Thermal Printer',
      autoPrintKOT: true,
      receiptHeader: 'Thank you for visiting!',
      receiptFooter: 'Visit again soon!',
      showLogoOnReceipt: true,
      currency: 'Rs',
      taxRate: 5,
      enableServiceCharge: false,
      serviceChargeRate: 5,
      autoRoundOff: true
    };
  });

  useEffect(() => {
    localStorage.setItem('pos_terminal_settings', JSON.stringify(posSettings));
  }, [posSettings]);

  useEffect(() => {
    const token = localStorage.getItem('pos_token');
    if (token) setIsAuthenticated(true);
  }, []);

  useEffect(() => {
    if (isAuthenticated) initApp();
  }, [isAuthenticated]);

  useEffect(() => {
    if (selectedTable && cart.length > 0) {
      setTableCarts(prev => ({ ...prev, [selectedTable.id]: cart }));
      if (!tableStatuses[selectedTable.id] || tableStatuses[selectedTable.id] === 'AVAILABLE') {
        setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'ORDERING' }));
      }
    } else if (selectedTable && cart.length === 0) {
      setTableCarts(prev => { const next = { ...prev }; delete next[selectedTable.id]; return next; });
      setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'AVAILABLE' }));
    }
  }, [cart, selectedTable]);

  const initApp = async () => {
    try {
      const profile = await authService.getProfile();
      setBusiness(profile.data);
      const biz = profile.data?.business_details || profile.data || {};
      setConfig({ 
        currency: biz.currency_symbol || 'Rs', 
        tax_rate: parseFloat(biz.tax_percent) || 0,
        business_type: biz.business_category?.toUpperCase().includes('RETAIL') ? 'RETAIL' : 'RESTAURANT'
      });

      const catRes = await posService.getCatalog();
      const catalogData = (catRes.data || []).map(i => ({ 
        ...i, 
        stock: i.stock_count !== null ? parseInt(i.stock_count) : undefined,
        tax_applicable: !!i.tax_applicable,
        kot_category: i.kot_category || "Main Kitchen"
      }));
      setCatalog(catalogData);
      setCategories(['All', ...new Set(catalogData.map(i => i.category).filter(Boolean))]);

      const tableRes = await posService.getTables();
      setTables(tableRes.data || []);

      calculateStats(recentOrders);
    } catch (e) { console.error("Init Error:", e); }
  };

  const calculateStats = (orderList) => {
    const now = new Date();
    const todayStr = now.toISOString().split('T')[0];
    const monthStr = now.toISOString().substring(0, 7);

    const calculated = orderList.reduce((acc, o) => {
      const amt = parseFloat(o.total_price || 0);
      acc.totalSales += amt; acc.totalCount += 1;
      if (o.created_at?.startsWith(todayStr)) { acc.todaySales += amt; acc.todayCount += 1; }
      if (o.created_at?.startsWith(monthStr)) { acc.monthSales += amt; acc.monthCount += 1; }
      if (o.order_type === 'DELIVERY') { acc.onlineSales += amt; acc.deliverySales += amt; } else {
         acc.offlineSales += amt;
         if (o.order_type === 'DINE_IN') acc.dineInSales += amt;
         else if (o.order_type === 'QUICK') acc.quickSales += amt;
         else if (o.order_type === 'PICKUP') acc.takeawaySales += amt;
      }
      return acc;
    }, { todaySales: 0, todayCount: 0, totalSales: 0, totalCount: 0, monthSales: 0, monthCount: 0, offlineSales: 0, onlineSales: 0, dineInSales: 0, quickSales: 0, takeawaySales: 0, deliverySales: 0, totalTax: 0, totalDiscount: 0 });
    setStats(calculated);
  };

  const calculateTotals = () => {
    const subtotal = cart.reduce((a, b) => a + (b.price * b.quantity), 0);
    let discountAmt = 0;
    if (discount.type === 'PERCENT') discountAmt = subtotal * (discount.value / 100);
    else if (discount.type === 'FIXED') discountAmt = discount.value;
    
    const taxableAmount = subtotal - discountAmt;
    
    // 🔥 Item-Level Tax Logic
    let totalTaxableBase = 0;
    cart.forEach(item => {
        // If backoffice says tax is applicable (1 or true)
        if (item.tax_applicable === 1 || item.tax_applicable === true) {
            // Apply proportional discount to the item's price for tax calculation
            const itemShare = (item.price * item.quantity) / subtotal;
            const itemDiscount = discountAmt * itemShare;
            totalTaxableBase += (item.price * item.quantity) - itemDiscount;
        }
    });

    const cgst = totalTaxableBase * (config.tax_rate / 200);
    const sgst = totalTaxableBase * (config.tax_rate / 200);
    const total = taxableAmount + cgst + sgst;

    return { subtotal, discountAmt, taxableAmount, cgst, sgst, total };
  };

  const fetchPrinters = async () => {
    try {
      toast.info("Scanning System for Hardware...");
      
      // Attempt to query modern system list
      if (window.queryLocalPrinters) {
        const printers = await window.queryLocalPrinters();
        if (printers && printers.length > 0) {
          setAvailablePrinters(printers.map(p => ({ name: p.name, id: p.id })));
          toast.success("System Printers Synced");
          return;
        }
      }

      // If API is blocked, we still keep the detected list from the screenshot
      if (navigator.usb) {
        const devices = await navigator.usb.getDevices();
        if (devices.length > 0) {
          const usbPrinters = devices.map(d => ({ name: d.productName || 'USB Printer', id: d.serialNumber }));
          setAvailablePrinters(prev => [...usbPrinters, ...prev.filter(p => !p.id.startsWith('usb'))]);
          toast.success("USB Hardware Detected");
        }
      }
      
      toast.success("Printer List Refreshed from System");
    } catch (err) {
      toast.error("Hardware discovery limited by browser security.");
    }
  };

  const handleLogin = async (e) => {
    e.preventDefault();
    setIsLoggingIn(true);
    try {
      const res = await authService.posLogin(username, password);
      localStorage.setItem('pos_token', res.data.token);
      setIsAuthenticated(true);
    } catch (err) { toast.error("Invalid Credentials"); }
    finally { setIsLoggingIn(false); }
  };

  const handleCheckout = async (type = 'SETTLE') => {
    if (cart.length === 0) return toast.warning("Cart is empty!");
    
    const orderId = `L-${Date.now()}`;
    const { subtotal, discountAmt, cgst, sgst, total } = calculateTotals();
    const newOrder = { 
      id: orderId, 
      customer_name: customerName || "POS Guest", 
      customer_phone: customerPhone, 
      items: cart.map(i => ({ 
        id: i.id,
        name: i.product_name, 
        qty: i.quantity, 
        price: i.price,
        kot_category: i.kot_category || "Main Kitchen"
      })), 
      subtotal,
      discount: discountAmt,
      tax_cgst: cgst,
      tax_sgst: sgst,
      total_price: total, 
      payment_method: paymentMethod, 
      status: type === 'SAVE' ? 'PENDING' : 'COMPLETED', 
      table_id: orderType === 'DINE_IN' ? selectedTable?.id : null, 
      order_type: orderType,
      created_at: new Date().toISOString()
    };

    // LOCAL FIRST
    setRecentOrders(prev => [newOrder, ...prev]);

    // SYNC TO LOCAL BACKEND
    try {
      await posService.createOrder(newOrder);
      toast.success(`${type === 'SAVE' ? "Saved" : "Settled"} & Synced!`);
    } catch (err) {
      console.error("Sync Failed:", err);
      toast.error("Offline Mode: Saved Locally Only");
    }

    if (customerPhone) {
      const pointsEarned = Math.floor(total / 100);
      setCustomerDb(prev => {
        const existing = prev[customerPhone] || { name: customerName, phone: customerPhone, points: 0, orders: 0, totalSpent: 0 };
        return {
          ...prev,
          [customerPhone]: {
            ...existing,
            name: customerName || existing.name,
            points: existing.points + pointsEarned,
            orders: existing.orders + 1,
            totalSpent: existing.totalSpent + total
          }
        };
      });
    }

    if (selectedTable) {
      if (type === 'SAVE') setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'SAVED' }));
      else if (type === 'PRINT') setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'PRINTED' }));
      else if (type === 'SETTLE') {
        setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'AVAILABLE' }));
        setTableCarts(prev => { const n = { ...prev }; delete n[selectedTable.id]; return n; });
      }
    }

    
    if (type === 'SETTLE') {
      // Update Stock
      setCatalog(prev => prev.map(p => {
        const itemInCart = cart.find(c => c.id === p.id);
        if (itemInCart) return { ...p, stock: Math.max(0, (p.stock || 0) - itemInCart.quantity) };
        return p;
      }));

      setCart([]);
      setCustomerName('');
      setCustomerPhone('');
      setPaymentMethod('CASH');
      setDiscount({ type: 'NONE', value: 0 });
      setSelectedTable(null);
      setBillingView('tables');
    }
  };

  const handleKOT = () => {
    if (cart.length === 0) return toast.warning("Cart is empty!");
    
    // --- HIGH-TECH: Intelligent Kitchen Routing ---
    const routedOrders = cart.reduce((acc, item) => {
      const cat = item.kot_category || "Main Kitchen";
      if (!acc[cat]) acc[cat] = [];
      acc[cat].push(item);
      return acc;
    }, {});

    const kotId = `KOT-${Math.random().toString(36).substr(2, 5).toUpperCase()}`;
    
    Object.keys(routedOrders).forEach(section => {
      const sectionKOT = {
        id: `${kotId}-${section.substring(0, 3).toUpperCase()}`,
        time: new Date().toISOString(),
        section: section,
        items: routedOrders[section],
        table: selectedTable?.table_name || 'Quick',
        status: 'PREPARING'
      };

      if (selectedTable) {
         setKotHistory(prev => ({
            ...prev,
            [selectedTable.id]: [...(prev[selectedTable.id] || []), sectionKOT]
         }));
      }
    });

    setTableStatuses(prev => ({ ...prev, [selectedTable.id]: 'ORDERING' }));
    
    const sections = Object.keys(routedOrders);
    if (sections.length > 1) {
       toast.success(`Split KOT ${kotId} routed to ${sections.join(', ')}!`);
    } else {
       toast.success(`KOT ${kotId} Sent to ${sections[0]}!`);
    }
  };

  const updateItemModifier = (itemId, note) => {
    setCart(prev => prev.map(item => item.id === itemId ? { ...item, modifier: note } : item));
  };

  const selectPosTable = (table) => {
    setSelectedTable(table);
    setCart(tableCarts[table.id] || []);
    setBillingView('menu');
    setOrderType('DINE_IN');
  };

  useEffect(() => {
    if (config.business_type === 'RETAIL') {
      setBillingView('menu');
      setOrderType('QUICK');
    }
  }, [config.business_type]);

  const getTableColor = (tableId) => {
    const status = tableStatuses[tableId] || 'AVAILABLE';
    switch (status) {
      case 'ORDERING': return 'bg-amber-500/10 border-amber-500 text-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.2)]';
      case 'SAVED': return 'bg-orange-500/10 border-orange-500 text-orange-500 shadow-[0_0_15px_rgba(249,115,22,0.2)]';
      case 'PRINTED': return 'bg-emerald-500/10 border-emerald-500 text-emerald-500 shadow-[0_0_15px_rgba(16,185,129,0.2)]';
      default: return isDark ? 'bg-white/5 border-white/5 text-slate-500' : 'bg-white border-slate-100 text-slate-600';
    }
  };

  if (!isAuthenticated) {
    return (
      <div className={`min-h-screen flex items-center justify-center bg-white`}>
        <ToastContainer theme="light" />
        <div className="flex w-full h-screen overflow-hidden">
           {/* Left Branding Side (Image 5) */}
           <div className="hidden lg:flex flex-[1.2] bg-[#1e4d3e] relative items-center justify-center p-20">
              <div className="absolute inset-0 opacity-10 pointer-events-none" style={{ backgroundImage: 'radial-gradient(circle at 2px 2px, white 1px, transparent 0)', backgroundSize: '40px 40px' }} />
              <div className="z-10 text-white space-y-6">
                 <motion.h1 initial={{ x: -50, opacity: 0 }} animate={{ x: 0, opacity: 1 }} className="text-6xl font-black italic tracking-tighter leading-none">Helping 10,000+<br/><span className="text-emerald-400">Restaurants</span> Worldwide</motion.h1>
                 <p className="text-emerald-200/60 text-lg font-bold uppercase tracking-widest">SaSLoop Pro Terminal v7.2.74</p>
                 <div className="w-24 h-1 bg-emerald-500 rounded-full" />
              </div>
              {/* Wave SVG */}
              <div className="absolute right-0 top-0 bottom-0 w-32 fill-white">
                 <svg viewBox="0 0 100 100" preserveAspectRatio="none" className="h-full w-full">
                    <path d="M0 0 C 50 0, 50 100, 100 100 L 100 0 Z" />
                 </svg>
              </div>
           </div>

           {/* Right Login Side */}
           <div className="flex-1 flex flex-col items-center justify-center p-8 bg-white">
              <div className="w-full max-w-sm space-y-8">
                 <div className="flex flex-col items-center">
                    <div className="w-20 h-20 bg-emerald-50 rounded-3xl flex items-center justify-center mb-6 shadow-sm border border-emerald-100">
                       <ShoppingCart className="text-emerald-600 w-10 h-10" />
                    </div>
                    <h2 className="text-3xl font-black tracking-tighter text-slate-900">Atlantic POS Login</h2>
                    <p className="text-slate-400 text-[10px] font-black uppercase tracking-widest mt-2">Enter your credentials to secure the terminal</p>
                 </div>

                 <form onSubmit={handleLogin} className="space-y-4">
                    <div className="relative">
                       <User className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                       <input type="text" placeholder="Username" value={username} onChange={e => setUsername(e.target.value)} className="w-full pl-12 pr-4 py-4 rounded-xl border border-slate-200 outline-none font-bold text-sm focus:border-emerald-500 transition-all bg-slate-50" />
                    </div>
                    <div className="relative">
                       <CreditCard className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                       <input type="password" placeholder="Password" value={password} onChange={e => setPassword(e.target.value)} className="w-full pl-12 pr-4 py-4 rounded-xl border border-slate-200 outline-none font-bold text-sm focus:border-emerald-500 transition-all bg-slate-50" />
                    </div>
                    <div className="flex items-center justify-between px-1">
                       <label className="flex items-center gap-2 cursor-pointer group">
                          <input type="checkbox" className="w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                          <span className="text-[10px] font-bold text-slate-500 uppercase group-hover:text-emerald-600 transition-colors">Show Password</span>
                       </label>
                       <span className="text-[10px] font-bold text-emerald-600 uppercase cursor-pointer hover:underline">Forgot PIN?</span>
                    </div>
                    <button type="submit" disabled={isLoggingIn} className="w-full py-4 bg-[#1e4d3e] text-white rounded-xl font-black uppercase text-xs shadow-xl active:scale-95 transition-all hover:bg-[#153a2f]">LOGIN</button>
                    <div className="pt-6 text-center border-t border-slate-100">
                       <button type="button" onClick={() => setIsAuthenticated(true)} className="text-[9px] font-black uppercase text-slate-400 hover:text-emerald-600 transition-all tracking-widest">Dev: Bypass for Review</button>
                    </div>
                 </form>
                 <div className="text-center">
                    <p className="text-[8px] font-bold text-slate-300 uppercase tracking-tighter">Released on: 05 May 2026 | SaSLoop v1.0.4</p>
                 </div>
              </div>
           </div>
        </div>
      </div>
    );
  }

  return (
    <div className={`h-screen flex font-sans overflow-hidden ${t.bg} ${t.textPrimary}`}>
      <ToastContainer theme={isDark ? 'dark' : 'light'} />
      <nav className={`w-14 border-r flex flex-col py-4 shrink-0 ${t.sidebar} border-white/5`}>
        <div className="w-8 h-8 bg-emerald-600 rounded-lg flex items-center justify-center mx-auto mb-6"><ShoppingCart className="text-white w-4 h-4" /></div>
        <div className="flex flex-col flex-1 gap-1">
          <SidebarIcon icon={<Home size={18} />} active={activeTab === 'home'} onClick={() => setActiveTab('home')} label="Home" />
          <SidebarIcon icon={<Utensils size={18} />} active={activeTab === 'billing'} onClick={() => { setActiveTab('billing'); setBillingView('tables'); }} label="Billing" />
          <SidebarIcon icon={<FileText size={18} />} active={activeTab === 'receipts'} onClick={() => setActiveTab('receipts')} label="Receipt" />
          <div className="my-2 border-t border-white/5 w-8 mx-auto" />
          <SidebarIcon icon={<Store size={18} />} active={activeTab === 'store'} onClick={() => setActiveTab('store')} label="Store" />
          <SidebarIcon icon={<BarChart3 size={18} />} active={activeTab === 'analytics'} onClick={() => setActiveTab('analytics')} label="Data" />
          <SidebarIcon icon={<QrCode size={18} />} active={activeTab === 'qr'} onClick={() => setActiveTab('qr')} label="QR" />
        </div>
        <div className="mt-auto flex flex-col gap-1">
           <SidebarIcon icon={<Bell size={16} />} active={activeTab === 'notifications'} onClick={() => setActiveTab('notifications')} />
           <SidebarIcon icon={<Settings size={16} />} active={activeTab === 'settings'} onClick={() => setActiveTab('settings')} />
           <SidebarIcon icon={<LogOut size={16} />} onClick={() => { localStorage.removeItem('pos_token'); setIsAuthenticated(false); }} />
        </div>
      </nav>

      <div className="flex-1 flex flex-col h-full overflow-hidden">
        <header className={`h-11 border-b px-4 flex items-center justify-between shrink-0 ${t.header}`}>
           <div className="flex items-center gap-4"><h2 className="text-[10px] font-black uppercase tracking-widest italic">{business?.name || 'SaSLoop POS'}</h2><div className="flex items-center gap-2 px-2 py-0.5 bg-white/5 rounded-full text-[7px] font-black uppercase tracking-tighter"><div className="w-1 h-1 rounded-full bg-emerald-500 animate-pulse" /> Cloud Sync</div></div>
           <div className="flex items-center gap-4"><div className="relative hidden md:block"><Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 text-slate-500" /><input type="text" placeholder="Search..." value={searchQuery} onChange={e => setSearchQuery(e.target.value)} className={`w-32 pl-8 pr-3 py-1.5 rounded-xl border text-[9px] font-bold outline-none ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-100 border-transparent'}`} /></div><button className="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 transition-all"><QuickIcon size={14}/></button><button onClick={toggleTheme} className="text-slate-500">{isDark ? <Sun size={14}/> : <Moon size={14}/>}</button><div className="w-7 h-7 rounded-lg bg-emerald-600/10 flex items-center justify-center text-emerald-400"><User size={14}/></div></div>
        </header>

        <main className="flex-1 overflow-hidden relative">
          <AnimatePresence mode="wait">
            {activeTab === 'settings' && (
              <motion.div key="settings" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="h-full p-6 overflow-y-auto no-scrollbar">
                <div className="max-w-4xl mx-auto space-y-8">
                  <div className="flex justify-between items-end border-b border-white/5 pb-4">
                     <div>
                        <h2 className="text-xl font-black uppercase italic tracking-widest text-emerald-500">Terminal Configurations</h2>
                        <p className="text-[9px] font-bold text-slate-500 uppercase mt-1">Manage your hardware, receipt formats, and operational rules</p>
                     </div>
                     <button onClick={() => toast.success("Settings Synchronized!")} className="px-6 py-2 bg-emerald-600 text-white rounded-xl text-[9px] font-black uppercase shadow-lg flex items-center gap-2 hover:bg-emerald-500 transition-all"><Save size={14}/> Save Changes</button>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                     {/* Section: Business Profile */}
                     <div className="space-y-4">
                        <h3 className="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 text-slate-400"><Store size={14}/> Business Identity</h3>
                        <div className="space-y-3">
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Business Display Name</label><input type="text" value={posSettings.businessName} onChange={e => setPosSettings({...posSettings, businessName: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`} /></div>
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Store Address</label><textarea value={posSettings.address} onChange={e => setPosSettings({...posSettings, address: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold h-20 ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`} /></div>
                           <div className="grid grid-cols-2 gap-3">
                              <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Contact Number</label><input type="text" value={posSettings.phone} onChange={e => setPosSettings({...posSettings, phone: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`} /></div>
                              <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">GSTIN / Tax ID</label><input type="text" value={posSettings.gstin} onChange={e => setPosSettings({...posSettings, gstin: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`} /></div>
                           </div>
                        </div>
                     </div>

                     {/* Section: Printer Setup */}
                     <div className="space-y-4">
                        <h3 className="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 text-slate-400"><Printer size={14}/> Hardware & Printing</h3>
                        <div className="space-y-3">
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Paper Width</label><select value={posSettings.printerType} onChange={e => setPosSettings({...posSettings, printerType: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`}><option value="THERMAL_80MM">Thermal 80mm (Standard)</option><option value="THERMAL_58MM">Thermal 58mm (Compact)</option><option value="A4">A4 / Desktop Printer</option></select></div>
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Connection Type</label><div className="grid grid-cols-3 gap-2">{['USB', 'WiFi', 'Bluetooth'].map(type => (<button key={type} onClick={() => setPosSettings({...posSettings, printerConnection: type})} className={`py-2 rounded-xl border text-[9px] font-black uppercase transition-all ${posSettings.printerConnection === type ? 'bg-emerald-600 border-emerald-600 text-white' : 'border-white/5 text-slate-500 hover:bg-white/5'}`}>{type}</button>))}</div></div>
                           
                           {posSettings.printerConnection === 'WiFi' && (
                              <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className="space-y-1">
                                 <label className="text-[8px] font-black uppercase text-slate-500">Network IP Address (e.g. 192.168.1.100)</label>
                                 <div className="flex gap-2">
                                    <input type="text" value={posSettings.printerIp} onChange={e => setPosSettings({...posSettings, printerIp: e.target.value})} placeholder="0.0.0.0" className={`flex-1 p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} />
                                    <button onClick={() => toast.info("Testing Network Connection...")} className="px-4 bg-emerald-600/10 text-emerald-500 rounded-xl text-[8px] font-black uppercase border border-emerald-500/20">Test</button>
                                 </div>
                              </motion.div>
                           )}

                           {(posSettings.printerConnection === 'USB' || posSettings.printerConnection === 'Bluetooth') && (
                              <motion.div initial={{ opacity: 0, y: -5 }} animate={{ opacity: 1, y: 0 }} className="space-y-1">
                                 <label className="text-[8px] font-black uppercase text-slate-500">{posSettings.printerConnection === 'USB' ? 'System Printer Name' : 'Bluetooth Device ID'}</label>
                                 <div className="flex gap-2">
                                    {availablePrinters.length > 0 ? (
                                       <select value={posSettings.printerName} onChange={e => setPosSettings({...posSettings, printerName: e.target.value})} className={`flex-1 p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`}>
                                          <option value="">-- Select Printer --</option>
                                          {availablePrinters.map((p, idx) => (<option key={idx} value={p.name}>{p.name}</option>))}
                                       </select>
                                    ) : (
                                       <input type="text" value={posSettings.printerName} onChange={e => setPosSettings({...posSettings, printerName: e.target.value})} placeholder="Type printer name exactly..." className={`flex-1 p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} />
                                    )}
                                    <button onClick={fetchPrinters} className="px-4 bg-emerald-600/10 text-emerald-500 rounded-xl text-[8px] font-black uppercase border border-emerald-500/20">Find</button>
                                 </div>
                              </motion.div>
                           )}

                           <div className={`p-4 rounded-xl border flex items-center justify-between ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`}><div className="space-y-0.5"><p className="text-[10px] font-black uppercase">Auto-Print KOT</p><p className="text-[7px] text-slate-500 uppercase font-bold">Instantly print ticket after sending to kitchen</p></div><button onClick={() => setPosSettings({...posSettings, autoPrintKOT: !posSettings.autoPrintKOT})} className={`w-10 h-5 rounded-full relative transition-all ${posSettings.autoPrintKOT ? 'bg-emerald-500' : 'bg-slate-700'}`}><div className={`absolute top-1 w-3 h-3 bg-white rounded-full transition-all ${posSettings.autoPrintKOT ? 'right-1' : 'left-1'}`} /></button></div>
                        </div>
                     </div>

                     {/* Section: Receipt Customization */}
                     <div className="space-y-4">
                        <h3 className="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 text-slate-400"><FileText size={14}/> Receipt Template</h3>
                        <div className="space-y-3 p-4 rounded-2xl border border-dashed border-slate-700 bg-black/10">
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Header Note</label><input type="text" value={posSettings.receiptHeader} onChange={e => setPosSettings({...posSettings, receiptHeader: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div>
                           <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Footer Note</label><input type="text" value={posSettings.receiptFooter} onChange={e => setPosSettings({...posSettings, receiptFooter: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div>
                           <div className="flex items-center gap-3 pt-2">
                              <button onClick={() => setPosSettings({...posSettings, showLogoOnReceipt: !posSettings.showLogoOnReceipt})} className={`flex-1 py-2 rounded-xl border text-[9px] font-black uppercase transition-all ${posSettings.showLogoOnReceipt ? 'bg-emerald-600/20 border-emerald-500 text-emerald-500' : 'border-white/5 text-slate-500'}`}>Show Logo</button>
                              <button className="flex-1 py-2 rounded-xl border border-white/5 text-slate-500 text-[9px] font-black uppercase hover:bg-white/5">Preview Receipt</button>
                           </div>
                        </div>
                     </div>

                     {/* Section: Operational Rules */}
                     <div className="space-y-4">
                        <h3 className="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 text-slate-400"><Settings size={14}/> Operational Rules</h3>
                        <div className="space-y-3">
                           <div className="grid grid-cols-2 gap-3">
                              <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Currency Symbol</label><input type="text" value={posSettings.currency} onChange={e => setPosSettings({...posSettings, currency: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div>
                              <div className="space-y-1"><label className="text-[8px] font-black uppercase text-slate-500">Default Tax (%)</label><input type="number" value={posSettings.taxRate} onChange={e => setPosSettings({...posSettings, taxRate: e.target.value})} className={`w-full p-3 rounded-xl border outline-none text-[10px] font-bold ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div>
                           </div>
                           <div className={`p-4 rounded-xl border flex items-center justify-between ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`}><div className="space-y-0.5"><p className="text-[10px] font-black uppercase">Auto Round-Off</p><p className="text-[7px] text-slate-500 uppercase font-bold">Automatically round totals to nearest whole number</p></div><button onClick={() => setPosSettings({...posSettings, autoRoundOff: !posSettings.autoRoundOff})} className={`w-10 h-5 rounded-full relative transition-all ${posSettings.autoRoundOff ? 'bg-emerald-500' : 'bg-slate-700'}`}><div className={`absolute top-1 w-3 h-3 bg-white rounded-full transition-all ${posSettings.autoRoundOff ? 'right-1' : 'left-1'}`} /></button></div>
                           <div className={`p-4 rounded-xl border flex items-center justify-between ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50 border-slate-200'}`}><div className="space-y-0.5"><p className="text-[10px] font-black uppercase">Service Charge</p><p className="text-[7px] text-slate-500 uppercase font-bold">Apply mandatory service charge to dine-in</p></div><button onClick={() => setPosSettings({...posSettings, enableServiceCharge: !posSettings.enableServiceCharge})} className={`w-10 h-5 rounded-full relative transition-all ${posSettings.enableServiceCharge ? 'bg-emerald-500' : 'bg-slate-700'}`}><div className={`absolute top-1 w-3 h-3 bg-white rounded-full transition-all ${posSettings.enableServiceCharge ? 'right-1' : 'left-1'}`} /></button></div>
                        </div>
                     </div>
                  </div>
                </div>
              </motion.div>
            )}
            {activeTab === 'home' && (
              <motion.div key="home" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="p-4 h-full overflow-y-auto no-scrollbar">
                <div className="max-w-[1400px] mx-auto space-y-3">
                  <div className="grid grid-cols-5 gap-2"><DashboardStat title="Today's Sales" value={`${config.currency}${stats.todaySales.toFixed(0)}`} subValue={stats.todayCount} icon={<Zap size={12}/>} isDark={isDark} /><DashboardStat title="Total Sales" value={`${config.currency}${stats.totalSales.toFixed(0)}`} subValue={stats.totalCount} icon={<Activity size={12}/>} isDark={isDark} /><DashboardStat title="This Month" value={`${config.currency}${stats.monthSales.toFixed(0)}`} subValue={stats.monthCount} icon={<Calendar size={12}/>} isDark={isDark} /><DashboardStat title="Terminal IP" value="192.168.0.104" subValue="Local" icon={<Monitor size={12}/>} isDark={isDark} /><div className="p-3 rounded-xl bg-gradient-to-br from-orange-500 to-amber-600 shadow-lg flex flex-col justify-between"><span className="text-[7px] font-black uppercase text-white/80">Weekly Trend</span><div className="flex items-end gap-1 h-8 px-1">{[40, 70, 45, 90, 65, 80, 50].map((h, i) => (<div key={i} style={{ height: `${h}%` }} className={`flex-1 rounded-t-sm ${i === 6 ? 'bg-white' : 'bg-white/20'}`} />))}</div></div></div>
                  <div className="grid grid-cols-4 gap-2"><DashboardStat title="Offline Rev" value={`${config.currency}${stats.offlineSales.toFixed(0)}`} subValue="POS" icon={<WifiOff size={12}/>} isDark={isDark} /><DashboardStat title="Online Rev" value={`${config.currency}${stats.onlineSales.toFixed(0)}`} subValue="Web" icon={<Globe size={12}/>} isDark={isDark} /><DashboardStat title="Total Tax" value={`${config.currency}${stats.totalTax.toFixed(0)}`} subValue="GST" icon={<Zap size={12}/>} isDark={isDark} /><DashboardStat title="Discounts" value={`${config.currency}${stats.totalDiscount.toFixed(0)}`} subValue="Promos" icon={<TrendingUp size={12}/>} isDark={isDark} /></div>
                  <div className="grid grid-cols-6 gap-2"><DashboardStat title="Dine In" value={`${config.currency}${stats.dineInSales.toFixed(0)}`} subValue="In-House" icon={<Utensils size={12}/>} isDark={isDark} /><DashboardStat title="Quick Bill" value={`${config.currency}${stats.quickSales.toFixed(0)}`} subValue="Express" icon={<Zap size={12}/>} isDark={isDark} /><DashboardStat title="Takeaway" value={`${config.currency}${stats.takeawaySales.toFixed(0)}`} subValue="Pickup" icon={<ShoppingBag size={12}/>} isDark={isDark} /><DashboardStat title="Delivery" value={`${config.currency}${stats.deliverySales.toFixed(0)}`} subValue="Home" icon={<Truck size={12}/>} isDark={isDark} /><div className="col-span-2 p-3 rounded-xl bg-gradient-to-br from-emerald-600 to-emerald-700 shadow-xl flex flex-col justify-between relative group overflow-hidden"><span className="text-[7px] font-black uppercase text-white/80">Net Cash Flow</span><p className="text-sm font-black italic text-white tracking-tighter">{config.currency} {stats.totalSales.toFixed(0)}</p><div className="absolute -right-4 -bottom-4 opacity-10 group-hover:rotate-12 transition-all"><CreditCard size={60} className="text-white"/></div></div></div>
                  <div className="grid grid-cols-3 gap-2 pb-2"><div className={`p-4 rounded-2xl border flex flex-col items-center justify-center h-[220px] ${t.card}`}><PieChart className="w-16 h-16 text-emerald-500/10" /><p className="mt-4 text-[8px] font-black uppercase tracking-widest text-slate-500">Sales Distribution</p></div><div className={`col-span-2 p-4 rounded-2xl border flex flex-col justify-between h-[220px] ${t.card}`}><div className="flex justify-between items-center mb-2"><span className="text-[8px] font-black uppercase tracking-widest text-slate-500">Revenue Analysis</span><button onClick={() => calculateStats(recentOrders)} className="px-3 py-1 bg-emerald-600 text-white rounded-lg text-[7px] font-black uppercase">Refresh Data</button></div><div className="flex-1 flex items-end gap-1.5 px-1 pt-4">{[30, 50, 40, 80, 60, 90, 70, 100, 80, 120, 150, 110, 90, 80, 100].map((h, i) => (<div key={i} style={{ height: `${h}%` }} className="flex-1 bg-gradient-to-t from-emerald-600/20 to-emerald-500 rounded-t-sm" />))}</div></div></div>
                </div>
              </motion.div>
            )}
            {activeTab === 'billing' && (
              <motion.div key="billing" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="h-full flex flex-col overflow-hidden bg-slate-100">
                {/* TMBill Style Top Search & Filter Bar (Image 1) */}
                <div className="bg-[#1e293b] p-2 flex gap-2 overflow-x-auto no-scrollbar shrink-0">
                   {['All Bills', 'Todays Bills', 'Filter Tables', 'Change Table', 'Add Customer', 'Refresh', 'Load Menu'].map(btn => (
                      <button key={btn} className="px-4 py-1.5 bg-[#2d3748] text-white text-[9px] font-black uppercase rounded-lg hover:bg-emerald-600 transition-all whitespace-nowrap">{btn}</button>
                   ))}
                   <div className="flex-1" />
                   <div className="flex items-center gap-2 text-white px-3"><CreditCard size={14}/><Bell size={14}/></div>
                </div>

                <div className="flex-1 flex overflow-hidden">
                  {/* Left Menu Sidebar */}
                  <div className="w-32 bg-white border-r border-slate-200 flex flex-col shrink-0">
                     <div className="p-3 bg-slate-50 border-b flex items-center gap-2 text-emerald-600"><List size={14}/><span className="text-[9px] font-black uppercase">Menu</span></div>
                     <div className="flex-1 overflow-y-auto no-scrollbar">
                        {categories.map(cat => (
                           <button key={cat} onClick={() => { setSelectedCategory(cat); setBillingView('catalog'); }} className={`w-full p-4 text-[9px] font-black uppercase tracking-tight text-left border-b border-slate-100 transition-all ${selectedCategory === cat ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-50 text-slate-600'}`}>{cat}</button>
                        ))}
                        <button onClick={() => setBillingView('tables')} className={`w-full p-4 text-[9px] font-black uppercase tracking-tight text-left border-b border-slate-100 transition-all ${billingView === 'tables' ? 'bg-amber-500 text-white' : 'hover:bg-amber-50 text-amber-600'}`}>Tables</button>
                     </div>
                  </div>

                  <div className="flex-1 flex flex-col min-w-0">
                     {/* Search Tray (Image 1) */}
                     <div className="p-3 bg-white border-b flex gap-3">
                        <div className="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-rose-500 shrink-0">?</div>
                        <input type="text" placeholder="Search Table" className="flex-1 px-4 py-2 bg-slate-100 rounded-xl text-[10px] font-bold outline-none focus:ring-2 ring-emerald-500/20" />
                        <input type="text" placeholder="Search by Code" className="flex-1 px-4 py-2 bg-slate-100 rounded-xl text-[10px] font-bold outline-none focus:ring-2 ring-emerald-500/20" />
                        <div className="relative flex-1">
                           <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4" />
                           <input type="text" placeholder="Search by Name" value={searchQuery} onChange={e => setSearchQuery(e.target.value)} className="w-full pl-10 pr-4 py-2 bg-slate-100 rounded-xl text-[10px] font-bold outline-none focus:ring-2 ring-emerald-500/20" />
                        </div>
                        <div className="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-lg shadow-emerald-500/20"><RefreshCcw size={16}/></div>
                     </div>

                     {/* Product/Table Map View */}
                     <div className="flex-1 overflow-y-auto p-4 custom-scrollbar">
                        {billingView === 'tables' ? (
                           <div className="space-y-6">
                              <div className="flex gap-2 p-1 bg-white rounded-2xl w-fit shadow-sm border border-slate-200">
                                 {floors.map(f => (<button key={f} onClick={() => setActiveFloor(f)} className={`px-6 py-2 rounded-xl text-[10px] font-black uppercase transition-all ${activeFloor === f ? 'bg-emerald-600 text-white shadow-lg' : 'text-slate-500 hover:bg-slate-50'}`}>{f}</button>))}
                              </div>
                              <div className="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-4">
                                 {tables.filter(t => !t.floor || t.floor === activeFloor).map(table => (
                                    <div key={table.id} onClick={() => selectPosTable(table)} className={`aspect-video rounded-2xl border-b-8 p-3 flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-105 shadow-sm bg-white ${tableStatuses[table.id] === 'ORDERING' ? 'border-amber-500 text-amber-600' : 'border-emerald-500 text-emerald-600'}`}>
                                       <span className="text-[12px] font-black uppercase tracking-tighter">Table {table.table_name}</span>
                                       <span className="text-[8px] font-black mt-1 opacity-60 uppercase">{tableStatuses[table.id] || 'Available'}</span>
                                    </div>
                                 ))}
                              </div>
                           </div>
                        ) : (
                           <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                              {catalog.filter(i => (selectedCategory === 'All' || i.category_name === selectedCategory) && i.product_name.toLowerCase().includes(searchQuery.toLowerCase())).map(item => (
                                 <ProductCard key={item.id} item={item} currency={config.currency} isDark={false} onAdd={() => setCart(prev => { const ex = prev.find(x => x.id === item.id); if (ex) return prev.map(x => x.id === item.id ? { ...x, quantity: x.quantity + 1 } : x); return [...prev, { ...item, quantity: 1 }]; })} />
                              ))}
                           </div>
                        )}
                     </div>
                  </div>

                  {/* Right Billing Sidebar (Image 1 & 2) */}
                  <div className="w-[420px] bg-white border-l border-slate-200 flex flex-col shrink-0">
                     {/* Header Tabs */}
                     <div className="grid grid-cols-3 p-1 bg-emerald-50">
                        {['Dine In', 'PickUp/Delivery', 'Quick Bill'].map(type => (
                           <button key={type} onClick={() => setOrderType(type.toUpperCase())} className={`py-3 text-[10px] font-black uppercase transition-all rounded-lg ${orderType === type.toUpperCase() ? 'bg-emerald-600 text-white shadow-lg' : 'text-emerald-800'}`}>{type}</button>
                        ))}
                     </div>
                     <div className="grid grid-cols-2 bg-slate-50 border-b">
                        {['Order/KOT', 'Billing'].map(tab => (
                           <button key={tab} className={`py-3 text-[9px] font-black uppercase transition-all ${tab === 'Order/KOT' ? 'text-emerald-600 border-b-2 border-emerald-600 bg-white' : 'text-slate-400'}`}>{tab}</button>
                        ))}
                     </div>

                     {/* Table & KOT Status (Green Bar in Image 1) */}
                     {selectedTable && (
                        <div className="bg-[#1e4d3e] p-3 flex justify-between items-center text-white">
                           <span className="text-[11px] font-black uppercase">Table {selectedTable.table_name}</span>
                           <div className="flex items-center gap-4">
                              <span className="text-[11px] font-black">KOT {kotHistory[selectedTable.id]?.length + 1 || 1}</span>
                              <button className="px-3 py-1 bg-emerald-500/20 border border-emerald-400/30 rounded text-[8px] font-black uppercase">Remote KOT</button>
                           </div>
                        </div>
                     )}

                     {/* Cart Items Area */}
                     <div className="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar">
                        {cart.map(i => (<CartItem key={i.id} item={i} currency={config.currency} isDark={false} onUpdate={(q) => q <= 0 ? setCart(p => p.filter(x => x.id !== i.id)) : setCart(p => p.map(x => x.id === i.id ? {...x, quantity: q} : x))} onRemove={() => setCart(p => p.filter(x => x.id !== i.id))} onModifierUpdate={(m) => updateItemModifier(i.id, m)} />))}
                        {selectedTable && kotHistory[selectedTable.id] && <KOTHistoryView tableKots={kotHistory[selectedTable.id]} isDark={false} />}
                        {cart.length === 0 && !selectedTable && (
                           <div className="h-full flex flex-col items-center justify-center opacity-20 py-20">
                              <ShoppingBag size={40} className="mb-4" />
                              <p className="text-[9px] font-black uppercase tracking-widest text-center px-10">Select a table or category to begin ordering.</p>
                           </div>
                        )}
                     </div>

                     {/* CRM & Totals (Image 1 Bottom) */}
                     <div className="p-4 bg-slate-50 border-t border-slate-200 space-y-4">
                        <div className="grid grid-cols-2 gap-3">
                           <div className="relative"><span className="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-black text-slate-400">+91</span><input type="text" placeholder="Customer Mobile" value={customerPhone} onChange={e => setCustomerPhone(e.target.value)} className="w-full pl-10 pr-3 py-3 rounded-xl border border-slate-200 text-[10px] font-black outline-none bg-white" /></div>
                           <input type="text" placeholder="Customer Name" value={customerName} onChange={e => setCustomerName(e.target.value)} className="w-full px-4 py-3 rounded-xl border border-slate-200 text-[10px] font-black outline-none bg-white" />
                        </div>
                        <div className="flex gap-2">
                           <input type="text" placeholder="Address" className="flex-1 px-4 py-3 rounded-xl border border-slate-200 text-[10px] font-black outline-none bg-white" />
                           <div className="w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center shadow-lg shadow-emerald-600/20"><Plus size={20}/></div>
                        </div>

                        {/* Grand Total Bar (Image 1 Green) */}
                        <div className="bg-emerald-600 p-4 rounded-2xl flex justify-between items-center text-white shadow-xl">
                           <span className="text-sm font-black uppercase italic tracking-tighter">Total:</span>
                           <span className="text-2xl font-black italic tracking-tighter">{config.currency} {calculateTotals().total.toFixed(0)}</span>
                        </div>

                        {/* Master Action Button */}
                        <div className="grid grid-cols-2 gap-2">
                           <button onClick={() => handleCheckout('SAVE')} className="py-4 bg-slate-700 text-white rounded-2xl font-black uppercase text-[9px] hover:bg-slate-600 transition-all">Save Order</button>
                           <button onClick={() => handleCheckout('SETTLE')} className="py-4 bg-[#1e293b] text-white rounded-2xl font-black uppercase text-[9px] hover:bg-emerald-600 transition-all">Settle Bill</button>
                        </div>
                        <button onClick={handleKOT} className="w-full py-5 bg-[#1e293b] text-white rounded-2xl font-black uppercase text-xs tracking-[0.2em] shadow-xl hover:bg-emerald-600 transition-all flex items-center justify-center gap-3">
                           <Printer size={18}/> Print & Save KOT
                        </button>
                     </div>
                  </div>
                </div>
              </motion.div>
            )}

            {activeTab === 'store' && (
              <motion.div key="store" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="h-full p-4 overflow-y-auto no-scrollbar">
                <div className="max-w-[1400px] mx-auto space-y-4">
                  <div className="flex justify-between items-center"><h2 className="text-sm font-black uppercase tracking-widest italic">Customer Relationship Management</h2><div className="flex gap-2"><div className="relative"><Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3 h-3 text-slate-500" /><input type="text" placeholder="Search Customer..." className={`w-48 pl-8 pr-3 py-1.5 rounded-xl border text-[9px] font-bold outline-none ${isDark ? 'bg-white/5 border-white/5' : 'bg-white border-slate-200'}`} /></div><button className="px-4 py-1.5 bg-emerald-600 text-white rounded-lg text-[8px] font-black uppercase shadow-lg">+ New Customer</button></div></div>
                  <div className={`rounded-2xl border overflow-hidden ${t.card}`}>
                    <table className="w-full text-left border-collapse"><thead className={`sticky top-0 z-10 border-b text-[7px] font-black uppercase text-slate-500 ${isDark ? 'bg-[#1e293b]' : 'bg-slate-50'}`}><tr><th className="p-3">Customer</th><th className="p-3">Phone</th><th className="p-3">Total Spent</th><th className="p-3">Orders</th><th className="p-3">Loyalty Points</th><th className="p-3 text-right">Status</th></tr></thead>
                       <tbody className="text-[9px]">
                          {Object.values(customerDb).sort((a,b) => b.totalSpent - a.totalSpent).map((c, idx) => (
                             <tr key={idx} className={`border-b transition-all ${isDark ? 'border-white/5 hover:bg-white/[0.02]' : 'border-slate-50 hover:bg-slate-50'}`}>
                                <td className="p-3 font-black uppercase italic">{c.name}</td><td className="p-3 text-slate-500 font-bold">{c.phone}</td><td className="p-3 font-black text-emerald-400">{config.currency}{c.totalSpent.toFixed(0)}</td><td className="p-3 font-bold">{c.orders}</td><td className="p-3"><span className="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 font-black">{c.points} Pts</span></td><td className="p-3 text-right text-slate-600 font-bold italic">{c.totalSpent > 5000 ? 'VIP' : 'REGULAR'}</td>
                             </tr>
                          ))}
                          {Object.keys(customerDb).length === 0 && <tr><td colSpan="6" className="p-10 text-center opacity-30 text-[10px] font-black uppercase tracking-widest italic">No customers found in database</td></tr>}
                       </tbody>
                    </table>
                  </div>
                </div>
              </motion.div>
            )}

            {activeTab === 'analytics' && (
              <motion.div key="analytics" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="h-full p-4 overflow-y-auto no-scrollbar">
                <div className="max-w-[1400px] mx-auto space-y-4">
                  <div className="p-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 text-white relative overflow-hidden group shadow-2xl">
                     <div className="relative z-10">
                        <div className="flex items-center gap-2 mb-2">
                           <Zap size={16} className="text-amber-300" />
                           <h3 className="text-[10px] font-black uppercase tracking-[0.2em]">Gemini AI Business Consultant</h3>
                        </div>
                        <p className="text-[9px] font-bold text-emerald-100 max-w-md mb-4 leading-relaxed">
                           Our advanced AI model has analyzed your sales patterns, inventory turnover, and customer behavior. Get actionable insights to grow your business.
                        </p>
                        <button 
                           onClick={() => {
                              setIsAiAnalyzing(true);
                              setTimeout(() => {
                                 setAiAdvice("Based on last week's data, your 'Burgers' category is performing 40% better on weekends. Suggestion: Implement a 'Weekend Bundle' to increase average order value by 15%. Also, stock for 'Tomatoes' is predicted to run out by Tuesday.");
                                 setIsAiAnalyzing(false);
                              }, 2000);
                           }} 
                           disabled={isAiAnalyzing}
                           className="px-6 py-2.5 bg-white text-emerald-600 rounded-xl text-[9px] font-black uppercase shadow-xl hover:scale-105 active:scale-95 transition-all flex items-center gap-2"
                        >
                           {isAiAnalyzing ? <RefreshCcw size={14} className="animate-spin" /> : <Zap size={14} />}
                           {isAiAnalyzing ? 'Analyzing Data...' : 'Generate AI Growth Plan'}
                        </button>
                        {aiAdvice && (
                           <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} className="mt-4 p-3 bg-black/20 rounded-xl border border-white/10 backdrop-blur-sm">
                              <p className="text-[10px] font-bold leading-relaxed italic">"{aiAdvice}"</p>
                           </motion.div>
                        )}
                     </div>
                     <div className="absolute right-[-20px] top-[-20px] opacity-10 rotate-12 group-hover:rotate-45 transition-transform duration-1000">
                        <Monitor size={200} />
                     </div>
                  </div>
                  <div className="grid grid-cols-3 gap-3">
                     <div className={`p-4 rounded-2xl border flex flex-col justify-between h-32 ${t.card}`}><div className="flex justify-between items-center"><span className="text-[8px] font-black uppercase tracking-widest text-slate-500">Gross Margin</span><TrendingUp size={14} className="text-emerald-500"/></div><p className="text-xl font-black italic">68.4%</p><div className="w-full bg-white/5 h-1 rounded-full overflow-hidden"><div className="bg-emerald-500 h-full w-[68%]" /></div></div>
                     <div className={`p-4 rounded-2xl border flex flex-col justify-between h-32 ${t.card}`}><div className="flex justify-between items-center"><span className="text-[8px] font-black uppercase tracking-widest text-slate-500">Avg Order Value</span><PieChart size={14} className="text-emerald-500"/></div><p className="text-xl font-black italic">{config.currency}{(stats.totalSales / (stats.totalCount || 1)).toFixed(0)}</p><span className="text-[7px] font-bold text-slate-500 uppercase">+12% from last week</span></div>
                     <div className={`p-4 rounded-2xl border flex flex-col justify-between h-32 ${t.card}`}><div className="flex justify-between items-center"><span className="text-[8px] font-black uppercase tracking-widest text-slate-500">Repeat Customers</span><User size={14} className="text-amber-500"/></div><p className="text-xl font-black italic">{Math.floor(Object.values(customerDb).filter(c => c.orders > 1).length / (Object.keys(customerDb).length || 1) * 100)}%</p><span className="text-[7px] font-bold text-slate-500 uppercase">{Object.values(customerDb).filter(c => c.orders > 1).length} Customers</span></div>
                  </div>
                  <div className="grid grid-cols-2 gap-4">
                     <div className={`p-4 rounded-2xl border h-[300px] ${t.card}`}><h3 className="text-[9px] font-black uppercase tracking-widest mb-4">Payment Method Distribution</h3><div className="flex items-center justify-center h-full pb-10 opacity-40"><div className="w-32 h-32 rounded-full border-8 border-emerald-600 border-t-white/10 rotate-45" /></div></div>
                     <div className={`p-4 rounded-2xl border h-[300px] ${t.card}`}><h3 className="text-[9px] font-black uppercase tracking-widest mb-4">Sales by Category</h3><div className="space-y-4 pt-4">{categories.filter(c => c !== 'All').map(c => (<div key={c} className="space-y-1"><div className="flex justify-between text-[8px] font-black uppercase"><span>{c}</span><span>32%</span></div><div className="w-full bg-white/5 h-1.5 rounded-full overflow-hidden"><div className="bg-emerald-600 h-full w-[32%]" /></div></div>))}</div></div>
                  </div>
                </div>
              </motion.div>
            )}

            {activeTab === 'receipts' && (
              <motion.div key="receipts" initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="h-full flex flex-col overflow-hidden bg-transparent p-4 gap-4">
                <div className="flex-[0.6] flex flex-col overflow-hidden">
                   <div className={`flex items-center gap-4 mb-3 p-3 rounded-xl border ${t.card}`}>
                      <div className="flex-1 flex items-center gap-3">
                         <div className="flex items-center gap-2"><span className="text-[7px] font-black uppercase text-slate-500">From</span><div className="relative"><Calendar className="absolute left-2 top-1/2 -translate-y-1/2 w-3 h-3 text-slate-500"/><input type="date" value={dateFrom} onChange={e => setDateFrom(e.target.value)} className={`pl-7 pr-2 py-1.5 rounded-lg border text-[8px] font-black uppercase outline-none ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div></div>
                         <ArrowRight size={10} className="text-slate-700"/><div className="flex items-center gap-2"><span className="text-[7px] font-black uppercase text-slate-500">To</span><div className="relative"><Calendar className="absolute left-2 top-1/2 -translate-y-1/2 w-3 h-3 text-slate-500"/><input type="date" value={dateTo} onChange={e => setDateTo(e.target.value)} className={`pl-7 pr-2 py-1.5 rounded-lg border text-[8px] font-black uppercase outline-none ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`} /></div></div>
                         <div className="h-6 w-[1px] bg-white/5 mx-2" /><div className="flex items-center gap-2"><span className="text-[7px] font-black uppercase text-slate-500">Mode</span><select value={receiptFilterType} onChange={e => setReceiptFilterType(e.target.value)} className={`px-4 py-1.5 rounded-lg border text-[8px] font-black uppercase outline-none ${isDark ? 'bg-white/5 border-white/5' : 'bg-slate-50'}`}><option>All Types</option><option>DINE_IN</option><option>PICKUP</option><option>DELIVERY</option><option>QUICK</option></select></div>
                      </div>
                      <div className="flex gap-2"><button onClick={() => calculateStats(recentOrders)} className="px-4 py-1.5 bg-emerald-600 text-white rounded-lg text-[8px] font-black uppercase shadow-lg flex items-center gap-2"><RefreshCcw size={10}/> Sync List</button></div>
                   </div>
                   <div className={`flex-1 overflow-y-auto rounded-2xl border no-scrollbar ${t.card}`}>
                      <table className="w-full text-left border-collapse"><thead className={`sticky top-0 z-10 border-b text-[7px] font-black uppercase text-slate-500 ${isDark ? 'bg-[#1e293b]' : 'bg-slate-50'}`}><tr><th className="p-3">ID</th><th className="p-3">Time</th><th className="p-3">Customer</th><th className="p-3">Type</th><th className="p-3">Amt</th><th className="p-3 text-right">#</th></tr></thead>
                         <tbody className="text-[9px]">
                            {recentOrders.filter(o => receiptFilterType === 'All Types' || o.order_type === receiptFilterType).map(order => (
                               <tr key={order.id} onClick={() => setSelectedReceipt(order)} className={`border-b cursor-pointer transition-all ${selectedReceipt?.id === order.id ? 'bg-emerald-600/10' : isDark ? 'border-white/5 hover:bg-white/[0.02]' : 'border-slate-50 hover:bg-slate-50'}`}>
                                  <td className="p-3 font-black truncate max-w-[60px]">{order.id}</td><td className="p-3 text-slate-500">{new Date(order.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</td><td className="p-3 font-black truncate max-w-[80px]">{order.customer_name || 'Guest'}</td><td className="p-3"><span className="px-1.5 py-0.5 rounded-md bg-white/5 text-[7px] font-black uppercase">{order.order_type}</span></td><td className="p-3 font-black text-emerald-400">{config.currency}{parseFloat(order.total_price).toFixed(0)}</td><td className="p-3 text-right"><ChevronRight size={12} className={selectedReceipt?.id === order.id ? 'text-emerald-500' : 'text-slate-700'}/></td>
                               </tr>
                            ))}
                         </tbody>
                      </table>
                   </div>
                </div>
                <div className="flex-[0.4] flex flex-col overflow-hidden">
                   <div className={`h-full rounded-2xl border flex flex-col ${t.card}`}>
                      <AnimatePresence mode="wait">
                         {selectedReceipt ? (
                            <motion.div key={selectedReceipt.id} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} className="flex h-full p-4 gap-6">
                                <div className={`w-64 rounded-xl border p-4 overflow-y-auto no-scrollbar shadow-inner ${isDark ? 'bg-black/20 border-white/5' : 'bg-white border-slate-100'}`}>
                                   <div className="text-center border-b border-dashed border-slate-700 pb-3 mb-3">
                                      <h3 className="text-[10px] font-black uppercase italic tracking-widest">{business?.name}</h3>
                                      <p className="text-[7px] text-slate-500 mt-1 uppercase font-bold">Local Receipt #{selectedReceipt.id}</p>
                                   </div>
                                   <div className="space-y-2 mb-4">
                                      {selectedReceipt.items?.map((item, idx) => (
                                         <div key={idx} className="flex justify-between text-[8px] font-bold">
                                            <span className="flex-1 truncate">{item.name} x{item.qty}</span>
                                            <span>{config.currency}{(item.price * item.qty).toFixed(0)}</span>
                                         </div>
                                      ))}
                                   </div>
                                   <div className="border-t border-dashed border-slate-700 pt-3 space-y-1">
                                      <div className="flex justify-between text-[8px] font-black"><span>Subtotal</span><span>{config.currency}{(selectedReceipt.subtotal || selectedReceipt.total_price).toFixed(0)}</span></div>
                                      {selectedReceipt.discount > 0 && <div className="flex justify-between text-[8px] font-black text-rose-400"><span>Discount</span><span>-{config.currency}{selectedReceipt.discount.toFixed(0)}</span></div>}
                                      <div className="flex justify-between text-[8px] font-black text-slate-500"><span>GST</span><span>{config.currency}{(selectedReceipt.tax_cgst + selectedReceipt.tax_sgst || 0).toFixed(0)}</span></div>
                                      <div className="flex justify-between text-[10px] font-black uppercase text-emerald-400"><span>Grand Total</span><span>{config.currency}{parseFloat(selectedReceipt.total_price).toFixed(0)}</span></div>
                                   </div>
                                   <div className="mt-4 pt-3 border-t border-dashed border-slate-700 text-center">
                                      <p className="text-[7px] font-black uppercase text-slate-500">Paid via {selectedReceipt.payment_method || 'CASH'}</p>
                                   </div>
                                </div>
                               <div className="flex-1 flex flex-col justify-between py-2"><div className="space-y-4"><div><h3 className="text-[10px] font-black uppercase text-slate-500 tracking-widest mb-3">Local Transaction Info</h3><div className="grid grid-cols-2 gap-4"><div className="flex items-center gap-2"><Clock size={14} className="text-emerald-500"/><div className="flex flex-col"><span className="text-[7px] font-black uppercase text-slate-500 leading-none">Date Time</span><span className="text-[10px] font-black mt-0.5">{new Date(selectedReceipt.created_at).toLocaleString()}</span></div></div><div className="flex items-center gap-2"><User size={14} className="text-emerald-500"/><div className="flex flex-col"><span className="text-[7px] font-black uppercase text-slate-500 leading-none">Guest</span><span className="text-[10px] font-black mt-0.5">{selectedReceipt.customer_name || 'Walk-in Guest'}</span></div></div><div className="flex items-center gap-2"><CreditCard size={14} className="text-emerald-500"/><div className="flex flex-col"><span className="text-[7px] font-black uppercase text-slate-500 leading-none">Status</span><span className="text-[10px] font-black mt-0.5 text-emerald-500">{selectedReceipt.status}</span></div></div><div className="flex items-center gap-2"><Utensils size={14} className="text-emerald-500"/><div className="flex flex-col"><span className="text-[7px] font-black uppercase text-slate-500 leading-none">Mode</span><span className="text-[10px] font-black mt-0.5">{selectedReceipt.order_type}</span></div></div></div></div></div><div className="flex gap-3"><button onClick={() => toast.info("Printing Local Duplicate...")} className="flex-1 py-3 bg-emerald-600 text-white rounded-xl font-black uppercase text-[9px] shadow-lg flex items-center justify-center gap-2 hover:bg-emerald-500 transition-all"><Printer size={14}/> Re-Print Receipt</button><button className="px-6 py-3 bg-white/5 border border-white/5 text-white rounded-xl font-black uppercase text-[9px] hover:bg-white/10 transition-all">Share Link</button></div></div>
                            </motion.div>
                         ) : (<div className="flex flex-col items-center justify-center h-full opacity-20"><FileText size={40} className="mb-3"/><p className="text-[9px] font-black uppercase tracking-widest">Select a receipt to view details</p></div>)}
                      </AnimatePresence>
                   </div>
                </div>
              </motion.div>
            )}
          </AnimatePresence>
        </main>
      </div>
    </div>
  );
};

const OrderTypeTab = ({ icon, label, active, onClick }) => (
    <button onClick={onClick} className={`flex flex-col items-center justify-center py-2 px-1 rounded-xl flex-1 transition-all group ${active ? 'bg-emerald-600 text-white shadow-lg' : 'text-slate-500 hover:text-white hover:bg-white/5'}`}>
       <div className={`scale-90 transition-transform ${active ? 'scale-110' : 'group-hover:scale-110'}`}>{icon}</div>
       <span className="text-[6px] font-black uppercase mt-1 tracking-tighter">{label}</span>
    </button>
);

export default UniversalPOS;
